# Discord Bot Token from Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Target Guild (Server) ID
GUILD_ID=123456789012345678

# Target Voice Channel ID
VOICE_CHANNEL_ID=123456789012345678

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Couple Status Activity (Optional)
BOT_ACTIVITY="with Dnz 💖"
# Untuk Rich Presence berbingkai besar, gunakan tipe 'playing'
BOT_ACTIVITY_TYPE=playing

# Rich Presence (RPC) Card Settings
RPC_DETAILS="Menemani Pasangan 24/7"
RPC_STATE="Always Standby in Voice"
# Masukkan Key Aset dari Discord Developer Portal -> Rich Presence Art Assets
RPC_LARGE_IMAGE="2c19e923a3f4c852d8b884c557573d86"
RPC_LARGE_TEXT="Denia 💖 Dnz"

# Proteksi & Penegakan Nickname Otomatis (Anti-Tamper)
BOT_NICKNAME="Denia Istrinya Dnz"
